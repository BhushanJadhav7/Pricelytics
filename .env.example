# PostgreSQL Database Connection
# Format: postgresql://<user>:<password>@<host>:<port>/<dbname>
# For local dev fallback without Postgres: sqlite:///./pricelytics.db
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/pricelytics_db

# ML Model & Dataset Configurations
MODEL_PATH=dynamic_pricing_pipeline.pkl
DATASET_PATH=Train.csv

